# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# VS Code workspace settings (per-developer, like .Rproj.user above).
# Already in .Rbuildignore, so it never reached a tarball - this just keeps it
# out of `git status`.
.vscode/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Generated model outputs and result caches (reproducible via the
# analysis pipeline; kept out of the repo per issue #11)
analysis/out/
analysis/Rda/results_*
analysis/Rda/fit_*
analysis/Rda/factor_vintages*
analysis/Rda/insample*
fits/
outputs/

# Benchmark literature PDFs (see the References section of vignette("mfbdfm"))
analysis/benchmarks/*.pdf

# Eckert et al. (2025) replication material: the paper's own stored results
# (7.7 MB) and the superseded scripts they came with. Kept locally, not
# committed - see analysis/fcast/README.md for what they are and what the
# scripts absorbed from them.
analysis/fcast/reference/

# The BMDFM benchmark's vendored source: 23 files taken from the `nowcasting`
# package (github.com/nmecsys/nowcasting) with a local edit. Third-party code,
# kept locally like the rest of the replication material rather than
# redistributed here. run_bmdfm() will not run without it - see
# analysis/fcast/README.md.
analysis/benchmarks/functions_package_nowcasting/

# reference papers (copyrighted; kept locally, not committed)
*.pdf
paper_text.rds
appendix_text.rds

# dev/ scratch: MC run drivers, logs and interim result caches
dev/mc_log*.txt
dev/mc_err*.txt
dev/mc_results*.rds
# ...except the canonical snapshot, which is committed for the same reason
# dev/baseline.rds is: so it can be compared across commits, and so
# regenerating it shows up in the diff. See dev/mc_recovery.R.
!dev/mc_results.rds
dev/run_mc*.R

# demo/ run artefacts (the script is committed, its output is not)
demo/outputs/

# The raw bundle written by analysis/1_data_prep_dataset.R. Regenerable, and it
# holds the aggregated PRIVATE source data from data/dataset/ - unlike
# data_ch_dataset.Rda and data_ch_dataset_test.Rda next to it, which are the
# processed datasets already shipped under data/.
analysis/Rda/data_ch_dataset_raw.Rda
analysis/out/

# PRIVATE raw source files for analysis/1_data_prep_dataset.R. Never commit
# these: licensed source data, ~4.4 MB, and the processed result is already
# shipped as data/*.rda (which stays tracked - it is the package's own data).
data/dataset/
data/VIX/
data/benchmarks/
